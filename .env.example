# Supabase (Project Settings → API). Las dos primeras son públicas: viajan al navegador.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_. Se usa únicamente para "eliminar mi cuenta".
SUPABASE_SECRET_KEY=sb_secret_xxx

# URL pública de la app (para los links de los QR y los emails de auth).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
